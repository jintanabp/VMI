# =============================================================================
# VMI — local dev defaults (copy to .env and fill secrets)
# Production Docker overrides DATABASE_URL via docker-compose.yml
# =============================================================================
#
# ตั้งจริง ๆ แค่ 21 บรรทัดข้างล่างนี้ ที่เหลือในไฟล์เป็น override ทั้งหมด:
#
#   DATABASE_URL · NEXTAUTH_SECRET · NEXT_PUBLIC_AZURE_AD_CLIENT_ID/TENANT_ID
#   ADMIN_EMAILS · ALERT_EMAIL · DATA_SOURCE=fabric
#   ONELAKE_{TENANT,CLIENT,CLIENT_SECRET,WORKSPACE,LAKEHOUSE}_ID
#   STOCK_ONELAKE_{TENANT,CLIENT,CLIENT_SECRET,WORKSPACE,LAKEHOUSE}_ID
#   VDA_CUSTOMER_MAP (seed ครั้งแรก) · MASTER_REFRESH_ENABLED/HOUR/MINUTE
#
# ชื่อไฟล์ต้นทางทุกชุด ที่อยู่ของตาราง C4 บริบทโปร lakehouse ของยอดขายรายวัน
# และขั้นต่ำจำนวนแถว มีค่าที่ถูกต้องอยู่ในโค้ดแล้วและมีเทสต์คุม — ไม่ต้องตั้ง
#
# ทุกตัวข้างล่างยัง override ได้ แต่ค่าใน .env ชนะโค้ดเสมอและเงียบสนิทเวลาตั้งผิด
# ตั้งอะไรเพิ่มแล้วต้องเปิด /admin/sync กับ /admin/promo ตรวจทุกครั้ง
# =============================================================================

# Database — dev: prisma/dev.db | Docker: file:/app/data/vmi.db
DATABASE_URL="file:./dev.db"

# Session signing — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your-random-secret-here

# Azure AD — sales login (แยกจาก ONELAKE service principal)
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-client-id-here
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-tenant-id-here

# Redirect URI — must match Azure App Registration exactly
# Dev:  http://localhost:3000/auth/callback
# Prod: https://<your-domain>/auth/callback
# NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional confidential client (if Azure app is Web platform)
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_USE_CLIENT_SECRET=true

# Admin emails (comma or semicolon) — bootstrap on startup
ADMIN_EMAILS=your-email@company.com
# APP_ADMINS=your-email@company.com

# Data source: dummy | fabric
DATA_SOURCE=dummy

# --- Fabric OneLake master data (customer + salesman) ---
# Auth priority (same as ocr-po-matching):
#   1) ONELAKE_TENANT_ID + ONELAKE_CLIENT_ID + ONELAKE_CLIENT_SECRET
#   2) AZURE_TENANT_ID + AZURE_CLIENT_ID + AZURE_CLIENT_SECRET
#   3) az login (DefaultAzureCredential)
#   4) Admin manual refresh → interactive browser login
#
# ONELAKE_TENANT_ID=
# ONELAKE_CLIENT_ID=
# ONELAKE_CLIENT_SECRET=
# ONELAKE_WORKSPACE_ID=
# ONELAKE_LAKEHOUSE_ID=
# ONELAKE_SCAN_DIR=Files/exports/
# USE_FABRIC_MASTERS=true

# --- Fabric stock workspace (VMI-only, separate from masters) ---
# USE_FABRIC_STOCK=true
# STOCK_ONELAKE_TENANT_ID=
# STOCK_ONELAKE_CLIENT_ID=
# STOCK_ONELAKE_CLIENT_SECRET=
# STOCK_ONELAKE_WORKSPACE_ID=
# STOCK_ONELAKE_LAKEHOUSE_ID=
# STOCK_ONELAKE_SCAN_DIR=Files/exports/
# STOCK_COVER_ONELAKE_PATH=Files/exports/stock_cover_day.csv
# ONELAKE_WAREHOUSE_ID=

# --- เป้าขายเดือนนี้ (cross_target_current_month) ---
# ใช้สร้างแท็บ "ควรมีขาย" — สินค้าที่อยู่ในเป้าของเซลล์ที่ดูแลคลังนั้น แต่ยังไม่มีใน
# stock_cover_day (ร้านยังไม่เคยสต็อก) จึงไม่มีแถวให้กดสั่งบนหน้าสต็อก
# ไฟล์อยู่ lakehouse Bronze_OrderAgent ที่เดียว (masters lakehouse ไม่มี) โค้ดจึงมี
# ค่า default ชี้ไปที่นั่นให้เลย ไม่ต้องตั้งอะไรก็ทำงาน — ตั้งทับได้เมื่อย้ายที่
# CROSS_TARGET_WORKSPACE_ID=
# CROSS_TARGET_LAKEHOUSE_ID=
# CROSS_TARGET_AUTH_PROFILE=stock
# CROSS_TARGET_ONELAKE_PATH=Files/exports/cross_target_current_month.csv
# CROSS_TARGET_MIN_ROWS=100

# --- ทะเบียน VDA → รหัสลูกค้า ---
#
# เพิ่มคลังใหม่ทำที่หน้า /admin/vda ไม่ใช่ที่ไฟล์นี้
#
# ทะเบียนอยู่ในฐานข้อมูล (ตาราง VdaWarehouse) และชนะทุกบรรทัดข้างล่างนี้เสมอ
# VDA_CUSTOMER_MAP เหลือหน้าที่เดียวคือ seed ตอนตารางยังว่าง (deploy ครั้งแรก)
# หลังจากนั้นลบทิ้งได้ — ระบบไม่ย้อนกลับมาอ่านอีกถ้าทะเบียนมีข้อมูลแล้ว
# หลายรหัสลูกค้าต่อคลังคั่นด้วย | เช่น vda1:3231847|3231848
# VDA_CUSTOMER_MAP=vda1:3231847,vda2:5042814
#
# รายชื่อคลังที่ระบบรู้จัก ไม่ต้องตั้ง — รวมจากทะเบียนในฐานข้อมูล + คลังที่โผล่ใน
# stock_cover_day จริง ตั้งบรรทัดนี้เมื่อต้องการ "เอาเท่านี้เป๊ะ ๆ" เท่านั้น
# VDA_CODES=vda1,vda2,vda3,vda4,vda5
#
# รหัสเซลล์ที่ดูแลแต่ละคลัง ระบบหาเองจาก cross_target_current_month
# (จับ WarehouseCode ↔ รหัสลูกค้า) — ไม่มี env ให้ตั้งแล้ว เพราะการกรอกมือเคยผิด
# แล้วทำให้เซลล์เห็นออเดอร์ของร้านที่ไม่ใช่ของตัวเอง

# --- มูลค่าสต็อกจริงต่อ VDA (vda{N}_product_product) ---
# ใช้แทน "คงเหลือ × ราคาขาย" ในสรุปหน้าสต็อก — VDA ที่ไฟล์ยังไม่มีคอลัมน์ bi_stock_value
# จะถอยไปคิดจากราคาขายเองและขึ้นดอกจันที่หน่วย ไม่ต้องตั้งอะไรเพิ่ม
# ไฟล์อยู่ lakehouse เดียวกับ stock_cover_day (STOCK_ONELAKE_*)
# VDA_PRODUCT_MIN_ROWS=1
# ชี้ path บน OneLake เองรายตัว (ไม่ตั้ง = <scanDir>/vda{N}_product_product.csv)
# VDA_PRODUCT_ONELAKE_VDA1=Files/exports/vda1_product_product.csv
# ชี้ไฟล์ในเครื่องเองรายตัว (ไม่ตั้ง = data/cache/vda{N}_product_product.csv)
# VDA_PRODUCT_CSV_VDA1=

# --- SKU + C4 promo ---
# SKU_ONELAKE_PATH=Files/exports/item_barcode_map_v2.csv
#
# ตาราง C4 (cft_promotion_cash) — ปกติ "ไม่ต้องตั้งอะไรเลยสักตัว"
#
# ที่อยู่ของไฟล์ (workspace Bronze_OrderAgent / lakehouse / ชื่อไฟล์) เป็นค่า default
# ในโค้ดและมีเทสต์คุม ส่วนบริบท (DIVISIONSALE|CUSTOMERGROUP) อ่านจากไฟล์เองเมื่อไฟล์
# มีชุดเดียว ซึ่งเป็นจริงเสมอสำหรับตาราง cash (E|98 ทั้งใบ)
#
# ตัวแปรข้างล่างนี้มีไว้เผื่อวันที่ต้นทางย้ายที่หรือซอยหลายบริบทจริง ๆ เท่านั้น
# ตั้งผิดเมื่อไหร่ = ร้านไม่เห็นโปรสักตัวแบบเงียบ ๆ ไม่มี error ที่ไหนเลย
# (เกิดจริงบน production 25-26 ส.ค. 2026: server ตั้ง CFT_ONELAKE_PATH ไว้ที่ไฟล์
#  cft_promotion_credit.csv และตั้ง C4_VDA_DIVISION_MAP=vda1:S,vda3:B,vda4:W
#  ทั้งที่ไฟล์มีแต่ E|98 → sync ขึ้นเขียวทุกวัน แต่โปรผิดทั้งระบบอยู่สองวัน)
#
# ถ้าจะตั้ง ให้เปิดหน้า /admin/promo ตรวจหลังตั้งทุกครั้ง — หน้านั้นจะขึ้นแถบแดงทันที
# เมื่อคลังค้นด้วยบริบทที่ไม่มีในไฟล์ หรือเมื่อไฟล์ที่โหลดมาไม่ใช่ตาราง cash
#
# CFT_WORKSPACE_ID=
# CFT_LAKEHOUSE_ID=
# CFT_SCAN_DIR=Files/exports/
# auth profile ที่มีสิทธิ์อ่าน workspace นั้น (masters | stock) — default stock
# CFT_AUTH_PROFILE=stock
# CFT_ONELAKE_PATH=Files/exports/cft_promotion_cash.csv
# ชี้ไฟล์ในเครื่องเอง — ใช้ rollback ไปไฟล์ที่ sync ไว้ก่อนหน้าโดยไม่ต้อง build ใหม่
# PROMOTION_CSV=./data/cache/cft_promotion_cash.csv
# ชื่อกลุ่มโปร (ASSORTEDPRODUCTGROUP → DESCRIPTIONASSORTED) — lakehouse เดียวกับ C4
# ไม่มีไฟล์นี้ = UI แสดงรหัสกลุ่มเหมือนเดิม ไม่พัง
# ASSORTED_ONELAKE_PATH=Files/exports/cft_assorted_mapping.csv
# ASSORTED_MAPPING_CSV=./data/cache/cft_assorted_mapping.csv
# บริบทที่ใช้ค้นโปร — ไม่ตั้ง = อ่านจากไฟล์ (ถูกเสมอเมื่อไฟล์มีชุดเดียว)
# ตั้งเมื่อไฟล์มีหลายบริบทเท่านั้น และค่าต้องมีอยู่จริงในไฟล์
# C4_DEFAULT_DIVISION=E
# C4_DEFAULT_CUSGROUP=98
# C4_DEFAULT_REGION=COUNTRY
# คลัง VDA ทุกตัวเป็น division เดียวกันหมด (E) — ตั้งตัวนี้เมื่อวันหนึ่งไม่จริงเท่านั้น
# C4_VDA_DIVISION_MAP=vda1:E,vda2:E,vda3:E,vda4:E,vda5:E

# --- Daily sales history (factsales_odoo) ---
# SOLD_HISTORY_ONELAKE_PATH=Files/exports/factsales_odoo.csv
# SOLD_HISTORY_MIN_ROWS=1
# SOLD_HISTORY_AUTH_PROFILE=stock
# AI_LH_WORKSPACE_ID=
# AI_LH_LAKEHOUSE_ID=
# AI_LH_SCAN_DIR=Files/exports/

# Min row guards — reject refresh if file too small
# CUSTOMER_MIN_ROWS=20000
# SALESMAN_MIN_ROWS=1000
# STOCK_COVER_MIN_ROWS=100
# SKU_MIN_ROWS=50000
# CFT_MIN_ROWS=1000
# ASSORTED_MIN_ROWS=50

# Stock page filter
# STOCK_FILTER_MODE=from_db

# --- Daily Fabric auto-sync (Asia/Bangkok) ---
# เปิดอยู่ทุก environment โดย default — ตั้ง =false เพื่อปิด
# (ถ้าไม่ได้ตั้ง workspace ของ OneLake ไว้ scheduler จะข้ามให้เองอยู่แล้ว)
# MASTER_REFRESH_ENABLED=false
# MASTER_REFRESH_HOUR=3
# MASTER_REFRESH_MINUTE=30
# ข้อมูลกลางเก่ากว่ากี่ชั่วโมงจึงถือว่าต้องดึงใหม่
# ใช้ทั้งตอน boot (ไล่ตามรอบที่พลาดไปเพราะ restart) และตอนร้านกด "ตรวจข้อมูลใหม่"
# MASTER_REFRESH_MAX_AGE_HOURS=20

# ที่เก็บไฟล์สถานะ sync (master-refresh-status.json) — default data/logs
# VMI_STATUS_DIR=

# Alert when scheduled sync fails after retries (same as ocr-po-matching)
ALERT_EMAIL=jintana.b@sahapat.co.th
# SENDER_EMAIL=   # optional — Microsoft Graph sender mailbox (Mail.Send)

# --- New-product highlight ---
# SKU ถือว่า "ใหม่" ถ้าเพิ่งเข้าข้อมูล Fabric ภายในกี่วันล่าสุด (default 30)
# NEW_PRODUCT_DAYS=30

# --- Docker production only ---
# BACKUP_DIR=/app/backups
# FABRIC_CACHE_DIR=/app/data/cache

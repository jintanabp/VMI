generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ไม่ได้ใช้แล้ว (29 ก.ย. 2569) — ใครดูแลร้านไหนตัดสินจาก รหัสเซลล์ → VDA ตามทะเบียน VDA
/// คงตาราง + Store.salesRepId ไว้เพื่อไม่ต้อง migrate · ลบได้ในรอบที่มี migration อื่นอยู่แล้ว
model SalesRep {
  id     String  @id @default(cuid())
  email  String  @unique
  name   String
  stores Store[]
}

model Store {
  id              String               @id @default(cuid())
  code            String               @unique
  name            String
  salesRepId      String?
  salesRep        SalesRep?            @relation(fields: [salesRepId], references: [id])
  stockItems      StockItem[]
  orders          Order[]
  groupThresholds StoreGroupThreshold[]
  skuBlocks       StoreSkuBlock[]
  salesNotifications SalesNotification[]
}

model Sku {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  createdAt  DateTime    @default(now())
  stockItems StockItem[]
  promoTiers PromoTier[]
  orderItems OrderItem[]
  skuBlocks  StoreSkuBlock[]
}

model StockItem {
  storeId  String
  skuId    String
  stock    Float
  avgSales Float
  minDays  Int    @default(7)
  maxDays  Int    @default(15)
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku      Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([storeId, skuId])
}

model PromoTier {
  id        String @id @default(cuid())
  skuId     String
  minQty    Int
  discount  String
  sortOrder Int
  sku       Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model Order {
  id           String      @id @default(cuid())
  storeId      String
  /// รหัสที่ client สร้างต่อหนึ่งดราฟต์ — กันส่งซ้ำเมื่อกดสองที/เน็ตกระตุกแล้ว retry
  /// (null = ออเดอร์เก่าก่อนมีฟิลด์นี้ · unique จึงกันได้จริงแม้สอง request ชนกันพอดี)
  clientRequestId String?  @unique
  status       String      @default("pending_approval")
  rejectReason String?
  /// วันที่ร้านอยากรับของ — ร้านเลือกเองตอนกดส่ง (ค่าตั้งต้น = วันนี้ + LEAD_TIME_DAYS)
  ///
  /// เก็บเป็นวันล้วน ๆ เที่ยงคืนเวลาไทย ไม่ใช่ instant ที่มีเวลา เพราะปลายทาง ERP
  /// รับเป็น DATE และฝั่ง ocr ก็ส่งเที่ยงคืนเสมอ · null = ออเดอร์ที่ส่งก่อนมีฟีเจอร์นี้
  /// (11 ก.ย. 69) ซึ่งจะออก PO ที่ยังส่งเข้า ERP ไม่ได้จนกว่าจะมีคนกรอกให้
  deliveryDate DateTime?
  createdAt    DateTime    @default(now())
  approvedAt   DateTime?
  /// เวลาที่พนักงานตัดสิน (อนุมัติ *หรือ* ปฏิเสธ)
  /// เดิมมีแต่ approvedAt ซึ่งการปฏิเสธไม่เคยเขียน → ออเดอร์ที่ถูกปฏิเสธไม่มีวันเวลาเลย
  /// (null = ออเดอร์เก่าก่อนมีฟิลด์นี้ → ฝั่งอ่าน fallback ไป approvedAt)
  decidedAt    DateTime?
  /// อีเมลพนักงานที่อนุมัติ/ปฏิเสธ — ก่อนหน้านี้ไม่มีการบันทึกว่าใครทำอะไรเลย
  decidedBy    String      @default("")
  store        Store       @relation(fields: [storeId], references: [id])
  items        OrderItem[]
  purchaseOrders PurchaseOrder[]

  // SQLite ไม่ auto-index FK — query หลักทุกตัว (listOrders, order-history, badge
  // pending-count ที่ poll ทุก 60 วิ) เคยเป็น full scan + filesort บนตารางนี้
  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

/// PO ที่ออกจริง — สร้างตอนอนุมัติเท่านั้น
/// (ก่อนอนุมัติ การแบ่งกลุ่มเก็บไว้ที่ OrderItem.poGroup เพื่อไม่ให้มีแถว draft ค้าง
///  เมื่อพนักงานเปลี่ยนใจ — แนวเดียวกับ confirmed_groups ของ ocr-po-matching)
model PurchaseOrder {
  id          String   @id @default(cuid())
  orderId     String
  poNumber    String   @unique
  /// slot ในออเดอร์นั้น — "A", "B", ... ตรงกับ OrderItem.poGroup
  groupKey    String
  /// c4 = ทุกบรรทัดราคาตรง C4, override = ราคาที่แก้เอง, mixed = ผสม
  priceKind   String
  itemCount   Int
  totalQty    Int
  totalAmount Float
  exportPath  String?
  /// สถานะหลังออกเลข — ค่าที่ใช้ได้ดูที่ lib/po/po-status.ts (PO_STATUSES)
  /// เก็บเป็น String ไม่ใช่ enum ตั้งใจให้ปรับ flow ได้โดยไม่ต้อง migrate
  status      String      @default("issued")
  /// เวลาที่เปลี่ยนสถานะครั้งล่าสุด (null = ยังไม่เคยเปลี่ยนจากค่าเริ่มต้น)
  statusAt    DateTime?
  statusBy    String      @default("")
  /// หมายเหตุตอนเปลี่ยนสถานะ เช่น เหตุผลที่ยกเลิก
  statusNote  String      @default("")
  issuedBy    String      @default("")
  issuedAt    DateTime    @default(now())

  // --- ผลการส่งเข้า ERP (insertOCROrderToBill) ---
  // เพิ่มไว้ก่อนที่จะมีตัวส่งจริง เพราะไม่ว่าคำตอบจากทีม ERP จะออกมาทางไหน
  // ก็ต้องมีที่เก็บว่าใบไหนส่งไปแล้ว ส่งเมื่อไหร่ และพลาดเพราะอะไร
  //
  // **ไม่มีตาราง staging แยกเหมือน ocr-po-matching** — ของเขาเก็บรายบรรทัดเพราะหนึ่งออเดอร์
  // แตกเป็นหลายใบได้ ส่วนเรามี 1 แถวต่อ 1 PO และ poNumber เป็น unique อยู่แล้ว
  /// ส่งสำเร็จเมื่อไหร่ (null = ยังไม่สำเร็จ — ใบที่ยังอยู่ในคิวทั้งหมดคือ erpSentAt: null)
  /// ประทับด้วย compare-and-set บน { poNumber, erpSentAt: null } เพื่อกันส่งซ้ำตอนกดพร้อมกัน
  erpSentAt       DateTime?
  /// พยายามส่งครั้งล่าสุดเมื่อไหร่ — เขียนทุกครั้งรวมครั้งที่ล้มเหลว
  /// มีไว้ตอบว่า "ใบที่ค้างอยู่ เคยถูกลองส่งไปแล้วหรือยัง" ซึ่ง erpSentAt ตอบไม่ได้
  erpAttemptedAt  DateTime?
  /// เหตุผลที่ล้มเหลวครั้งล่าสุด — **เก็บข้อความดิบจากปลายทาง** ไม่ใช่ code ที่เราตีความเอง
  /// เพราะปลายทางไม่มีรหัส error เลย มีแต่ resultMsg เป็นภาษาอังกฤษ (ตัดที่ 1000 ตัวอักษรตอนเขียน)
  /// null = ยังไม่เคยพลาด · ส่งสำเร็จแล้วไม่ล้างค่านี้ เพื่อให้ยังเห็นว่าเคยพลาดมาก่อน
  erpError        String?
  /// ชนิดของความล้มเหลวครั้งล่าสุด — ค่าที่ใช้ได้ดูที่ `ErpSendFailure` (erp-delivery.ts)
  /// **สำคัญกับ clone-for-erp**: ขอเลขใหม่ได้เฉพาะ `"rejected"` (ปลายทางตอบปฏิเสธชัดเจน)
  /// เท่านั้น — `"timeout"`/`"network"` แปลว่า "ไม่รู้ว่าเข้าไปแล้วหรือไม่" ขอเลขใหม่ตอนนั้น
  /// เสี่ยงส่งซ้ำสองเลขถ้าใบเดิมเข้าไปจริง · null = แถวเก่าก่อนมีคอลัมน์นี้ ถือว่าไม่ชัดเจน
  /// เหมือนกัน (ห้ามเดาว่า rejected)
  erpFailureKind  String?
  /// จำนวนแถวที่ปลายทางบอกว่า insert ไป (result.insertedRows)
  /// เก็บไว้เทียบกับจำนวนบรรทัดที่ส่ง — ฝั่ง ocr อ่านค่านี้แต่ไม่เคยเทียบ เราควรเทียบ
  erpInsertedRows Int?

  // --- ขอเลขใหม่ให้ใบที่ ERP ปฏิเสธ (clone-for-erp) ---
  // เลข PO เดิมที่ยิงไปแล้วโดน ERP ปฏิเสธ ห้ามส่งซ้ำด้วยเลขเดิม (ล็อก 6 เดือน) — แนวเดียวกับ
  // ocr-po-matching/backend/order_clone.py: สร้างใบใหม่แทนการแก้เลขเดิม ไม่มีทางกู้ใบเก่าคืน
  /// ใบนี้เกิดจากการขอเลขใหม่ของใบไหน — null = ใบปกติ ไม่ใช่ใบที่ขอเลขใหม่มา
  erpReplacesPoNumber String?
  /// ใบนี้ถูกแทนที่ด้วยเลขใหม่ใบไหนแล้ว — null = ยังไม่เคยขอเลขใหม่
  replacedByPoNumber  String?
  /// เวลาที่ถูกแทนที่ — คู่กับ replacedByPoNumber เสมอ
  erpVoidedAt         DateTime?

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@unique([orderId, groupKey])
  @@index([orderId])
  // หน้า PO ของเซลล์ filter+sort ด้วย issuedAt/status พร้อม skip/take (pagination)
  @@index([issuedAt])
  @@index([status])
}

/// running number ของเลข PO ต่อ (คลัง, วัน) — ยืมแพทเทิร์น confirm_seq ของ ocr-po-matching
model PoSequence {
  bucket String @id
  lastN  Int    @default(0)
}

/// แจ้งเตือนร้านค้าเมื่อพนักงานทำอะไรกับออเดอร์
/// เก็บ snapshot ข้อความไว้เลย ไม่ผูกกับ Order ด้วย FK เพราะออเดอร์ที่ถูกลบ
/// ก็ยังต้องแจ้งร้านให้รู้ว่าถูกลบ
model StoreNotification {
  id        String    @id @default(cuid())
  storeId   String
  /// ชนิดทั้งหมด + ป้ายภาษาไทย ดูที่ lib/orders/store-notify-display.ts (เพิ่มชนิดใหม่ไม่ต้อง migrate)
  kind      String
  title     String
  detail    String    @default("")
  /// เลข PO ที่เกี่ยวข้อง คั่นด้วย comma (ว่างได้)
  poNumbers String    @default("")
  orderId   String?
  actorEmail String   @default("")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([storeId, readAt])
  @@index([storeId, createdAt])
}

/// แจ้งเตือนพนักงานขายเมื่อร้านทำอะไรกับออเดอร์ (ส่งใหม่ / ยกเลิกเอง)
/// ผูกกับ store ไม่ใช่ตัวเซลล์ เพราะสิทธิ์ของเซลล์คำนวณจาก VDA registry ตอน query
/// (ดู storeScopeWhere ใน app/api/sales/notifications/route.ts) — เก็บ salesCode ไว้ก็จะเพี้ยนเมื่อมีการย้ายเขต
/// acknowledgedAt เป็นค่ากลางต่อแถวแบบเดียวกับ StoreSkuBlock ที่ใช้อยู่แล้ว
model SalesNotification {
  id             String    @id @default(cuid())
  storeId        String
  /// ชนิดทั้งหมด + ป้ายภาษาไทย ดูที่ lib/orders/sales-notify-display.ts (เพิ่มชนิดใหม่ไม่ต้อง migrate)
  kind           String
  title          String
  detail         String    @default("")
  orderId        String?
  createdAt      DateTime  @default(now())
  /// รับทราบแบบรวม (ทุกคนใน VDA) — ใช้กับแถวก่อน 28 ก.ย. 2569 เท่านั้น · ตอนนี้เก็บต่อผู้ใช้ใน SalesNotificationRead
  acknowledgedAt DateTime?
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reads          SalesNotificationRead[]

  @@index([storeId, acknowledgedAt])
  @@index([createdAt])
}

/// เซลล์คนไหนรับทราบแจ้งเตือนไหนแล้ว — เดิมคนหนึ่งเปิดกระดิ่ง = ทุกคนใน VDA เห็นว่าอ่านแล้ว (QA 28 ก.ย. 69)
model SalesNotificationRead {
  notificationId String
  email          String
  readAt         DateTime          @default(now())
  notification   SalesNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, email])
  @@index([email])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  skuId        String
  suggestedQty Int
  finalQty     Int
  /// finalQty ที่ร้านส่งมาตอนแรก แช่ไว้ตอนสร้างออเดอร์ ไม่แก้อีก — ใช้เทียบกับ finalQty
  /// ปัจจุบันว่าพนักงานแก้จำนวนไปจากที่ร้านขอไหม (null = ออเดอร์เก่าก่อนมีฟีเจอร์นี้)
  requestedQty Int?
  /// พนักงานแก้ finalQty ให้มากกว่า requestedQty แล้วรอร้านยืนยัน — ลดได้เลยไม่ต้องรอ
  /// (ดู updateOrderItemQty) ห้ามอนุมัติออเดอร์ทั้งใบขณะที่ยังมีรายการค้างสถานะนี้อยู่
  qtyIncreasePendingConfirm Boolean @default(false)
  /// จำนวนล่าสุดที่ร้านตกลงแล้ว — ตอนส่ง = requestedQty · ร้านกดยืนยันการเพิ่ม = finalQty ณ ตอนนั้น
  /// ใช้เป็นเส้นฐานว่า "เพิ่มเกิน" ต้องรอยืนยันไหม และร้านปฏิเสธแล้วคืนจำนวนเป็นเท่าไร
  /// (requestedQty ยังแช่ของเดิมไว้แยก PO-C/D) · null = แถวก่อนมีคอลัมน์นี้ → ใช้ requestedQty แทน
  /// สินค้าที่พนักงานเพิ่มเอง: 0 จนกว่าร้านยืนยัน — ปฏิเสธตอนยัง 0 = ลบแถว, หลังยืนยันแล้ว = คืนจำนวน
  agreedQty    Int?
  cvdEstimate  Float?
  // threshold ที่ร้านใช้ตอนสั่ง — "แช่แข็ง" ไว้ให้ฝั่งเซลส์คำนวณสีธง CVD ตรงกับที่ร้านเห็น
  // (null = ออเดอร์เก่าก่อนมีฟีเจอร์นี้ → getCvdFlag ใช้ค่า default เดิม)
  minDays      Int?
  maxDays      Int?

  // --- ราคาที่ร้านแก้เอง + สแนปช็อตราคา C4 ณ เวลาส่ง ---
  // ราคามาจาก CSV master ซึ่งเปลี่ยนรายวัน ถ้าไม่แช่ค่าไว้ อีกสัปดาห์จะพิสูจน์ไม่ได้ว่า
  // ตอนร้านกดส่ง ราคาต่างกันจริงหรือไม่ (เหตุผลเดียวกับที่แช่ minDays/maxDays ไว้)
  /// ราคา/หีบ ที่ร้านพิมพ์เอง (null = ไม่ได้แก้ ใช้ราคาระบบ)
  unitPriceOverride Float?
  /// ราคา/หีบ จาก SKU master (CASHUNITPRICE) ณ เวลาส่ง
  c4UnitPrice       Float?
  c4DiscountBaht    Float?
  c4DiscountPct     Float?
  c4NetUnitPrice    Float?
  /// ราคาในมาสเตอร์หมดอายุแล้ว ณ เวลาส่ง (null = ออเดอร์เก่าก่อนมีฟีเจอร์นี้)
  c4PriceExpired    Boolean?
  /// ร้านแก้ราคาแล้วไม่ตรง C4 — ตัดสินฝั่งเซิร์ฟเวอร์ตอนส่ง ไม่คำนวณใหม่ตอนอ่าน
  priceFlagged      Boolean  @default(false)
  /// mismatch | no_baseline | unverified
  priceFlagReason   String?

  // --- สแนปช็อตโปรโมชัน + ของแถม ณ เวลาส่ง ---
  // เหตุผลเดียวกับราคา: แคมเปญเปลี่ยนตลอด ถ้าไม่แช่ไว้ อีกเดือนพิสูจน์ไม่ได้ว่าตอนร้านกดส่ง
  // ระบบบอกว่าจะได้โปร/ของแถมอะไร — เดิมข้อมูลนี้ถูกคำนวณตอนส่งแล้วทิ้งทั้งหมด
  // (null = ออเดอร์ก่อนมีฟีเจอร์นี้ ≠ "ไม่มีโปร" — ต้องแยกสองอย่างนี้ตอนแสดงผล)
  /// ข้อความขั้นโปรที่ได้ ณ เวลาส่ง เช่น "ลด 20 บาท/หีบ"
  c4PromoLabel        String?
  /// ชนิดขั้นโปร (discount | premium | ...)
  c4PromoKind         String?
  /// กลุ่มโปรที่รวมยอดข้าม SKU — ใช้ dedupe ของแถมตอนแสดง/ส่งออก
  c4PromoGroup        String?
  c4PromoGroupMembers Int?
  /// ยอดรวมของกลุ่มที่ใช้ตัดสินขั้นโปร — อธิบายว่าทำไมสั่ง 3 หีบถึงได้ขั้น 50
  c4PooledQty         Int?
  /// ของแถมที่ควรได้ ณ เวลาส่ง (โปรกลุ่มจะซ้ำกันทุกบรรทัดในกลุ่ม — ต้อง dedupe ตอนอ่าน)
  c4FreeGoodCode      String?
  c4FreeGoodName      String?
  c4FreeGoodQty       Int?
  c4FreeGoodUnit      String?
  /// สมาชิกกลุ่มโปรเดียวกันในออเดอร์นี้ได้ส่วนลด/pooledQty ไม่ตรงกัน — เตือนเฉย ๆ ไม่บล็อก
  /// (ตัดสินฝั่งเซิร์ฟเวอร์ตอนส่ง เหตุผลเดียวกับ priceFlagged)
  discountFlagged     Boolean @default(false)
  /// group_mismatch | pooled_qty_mismatch
  discountFlagReason  String?

  // --- ราคาที่พนักงานแก้ + การแบ่ง PO ---
  // แยกช่องจาก unitPriceOverride ของร้าน เพื่อไม่ให้ทับหลักฐานว่าร้าน "ขอ" ราคาเท่าไร
  /// ราคา/หีบ ที่พนักงานตั้ง (null = ใช้ของร้าน หรือราคาระบบ)
  salesPriceOverride Float?
  salesPriceBy       String    @default("")
  salesPriceAt       DateTime?
  /// กลุ่ม PO ที่พนักงานจัดไว้ ("A".."Z") — null = ยังไม่จัด
  poGroup            String?
  purchaseOrderId    String?

  // --- พนักงานปฏิเสธรายการนี้ (คนละอันกับปฏิเสธทั้งออเดอร์) ---
  // แค่บันทึกไว้ดูย้อนหลัง — ตัวที่กันไม่ให้รายการนี้เข้า PO คือ finalQty=0 เดิม
  // (approve-with-split.ts กรอง finalQty>0 ออกอยู่แล้ว ไม่ต้องเพิ่มเงื่อนไขใหม่)
  rejectedAt   DateTime?
  rejectReason String?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku           Sku            @relation(fields: [skuId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([orderId])
  @@index([purchaseOrderId])
}

model AllowedSalesCode {
  code      String   @id
  createdAt DateTime @default(now())
}

/// ผู้ดูแลระบบ — bootstrap จาก ADMIN_EMAILS / APP_ADMINS แล้วเพิ่มผ่าน UI ได้
model Admin {
  email   String   @id
  fromEnv Boolean  @default(false)
  addedBy String   @default("")
  addedAt DateTime @default(now())
}

/// บัญชีร้านค้า — login ด้วยอีเมล + รหัสผ่านที่ตั้งเอง (แอดมินอนุมัติสิทธิ)
model StoreAccount {
  id               String    @id @default(cuid())
  email            String    @unique
  vdaCode          String
  status           String    @default("pending") // pending | approved | rejected
  passwordHash     String?
  mustSetPassword  Boolean   @default(true)
  canManageMinMax  Boolean   @default(false)
  resetRequestedAt DateTime?
  approvedBy       String    @default("")
  /// รหัสตั้งค่าครั้งแรก (ใช้ครั้งเดียว) — เก็บแต่ sha256 ของรหัส · แอดมินเห็นตัวรหัสครั้งเดียวตอนออก
  /// แล้วส่งต่อให้ร้าน · ตั้งรหัสผ่านครั้งแรก/หลังรีเซ็ตต้องมีรหัสนี้ (เดิมรู้แค่อีเมลก็ยึดบัญชีได้ — QA 28 ก.ย. 69)
  setupCodeHash      String?
  setupCodeExpiresAt DateTime?
  /// เพิ่มทุกครั้งที่สิทธิ์/รหัสผ่านของบัญชีเปลี่ยน — session ร้านที่ออกก่อนหน้า (เลขไม่ตรง) ใช้ไม่ได้ทันที
  sessionVersion     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([vdaCode])
}

/// ค่า min/max ระดับ product group (Section) ต่อร้าน — ใช้เป็น default ก่อน override รายตัว
model StoreGroupThreshold {
  id        String   @id @default(cuid())
  storeId   String
  section   String
  minDays   Int      @default(7)
  maxDays   Int      @default(15)
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, section])
}

/// รายการ "หยุดสั่ง / เอาออกจากคลัง" ต่อร้านต่อ SKU — ระงับ suggest และแจ้งเซลล์
model StoreSkuBlock {
  id             String    @id @default(cuid())
  storeId        String
  skuId          String
  reason         String
  effectiveFrom  DateTime  @default(now()) // เริ่มหยุดสั่งตั้งแต่เมื่อไหร่ (อาจเป็นอนาคต)
  effectiveTo    DateTime?                 // สิ้นสุดการหยุดสั่ง (null = หยุดถาวร)
  createdBy      String    @default("")
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?                 // รับทราบแบบรวม — แถวก่อน 28 ก.ย. 69 · ตอนนี้ต่อผู้ใช้ใน StoreSkuBlockRead
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku            Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  reads          StoreSkuBlockRead[]

  @@unique([storeId, skuId])
  @@index([storeId])
}

/// เซลล์คนไหนรับทราบการหยุดสั่งไหนแล้ว (ต่อผู้ใช้ — เหตุผลเดียวกับ SalesNotificationRead)
model StoreSkuBlockRead {
  blockId String
  email   String
  readAt  DateTime      @default(now())
  block   StoreSkuBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([blockId, email])
  @@index([email])
}

/// ทะเบียนคลัง VDA — "vda1 คือลูกค้ารหัสไหน" แก้ได้จากหน้าแอดมิน ไม่ต้องแตะ .env
///
/// ความรู้นี้ไม่มีไฟล์ไหนบอกได้ (ชื่อใน dim_customer เป็นชื่อบริษัท ไม่มีคำว่า VDA)
/// เดิมจึงอยู่ใน VDA_CUSTOMER_MAP ซึ่งแปลว่าเปิดคลังใหม่ทีต้อง ssh เข้าไปแก้ไฟล์
/// แล้ว restart — ตอนนี้ env เหลือหน้าที่แค่ seed ตอนตารางยังว่างเท่านั้น
model VdaWarehouse {
  code          String   @id                    // "vda1" (normalize แล้ว)
  customerCodes String                          // รหัสลูกค้า คั่นด้วย | ถ้ามีหลายรหัส
  label         String   @default("")           // ชื่อที่คนเรียก เช่น "คลังบางพลี"
  active        Boolean  @default(true)         // ปิดชั่วคราวได้โดยไม่ต้องลบประวัติ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// แอดมินกำหนดเองว่าอีเมลไหนเข้าใช้งานในฐานะรหัสเซลล์ (SXXX) ไหนได้บ้าง
///
/// **แหล่งเดียวของ อีเมล ↔ รหัสเซลล์** ตั้งแต่ 28 ก.ย. 2569 (เลิกใช้ cross_salesman master) —
/// อีเมลที่ไม่มีแถว active ที่นี่ login ฝั่งเซลล์ไม่ได้ · รหัส ↔ VDA ยังมาจากทะเบียน VDA
/// (lib/fabric/vda-aos-bill.ts) · เอาออก = ลบแถว (ประวัติอยู่ใน AdminAuditLog)
model SalesmanEmailAssignment {
  id           String   @id @default(cuid())
  email        String                          // normalize เป็นตัวพิมพ์เล็กเสมอ
  salesmanCode String                          // "S091" (normalize เป็นตัวพิมพ์ใหญ่เสมอ)
  active       Boolean  @default(true)         // ปิดชั่วคราวได้โดยไม่ต้องลบประวัติ
  createdBy    String                          // อีเมลแอดมินที่ตั้งค่านี้ไว้
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([email, salesmanCode])
  @@index([email])
  @@index([salesmanCode])
}

/// บันทึกการกระทำของผู้ดูแลระบบ (Creator/Admin) และการลบออเดอร์ — ใคร ทำอะไร กับอะไร เมื่อไหร่
///
/// ไม่ผูก FK กับเป้าหมาย เพราะหลายอย่างที่ต้องจดคือ "การลบ" — แถวต้นทางหายไปแล้วบันทึกต้องยังอยู่
/// **ห้ามเก็บความลับ** (รหัสตั้งค่า / รหัสผ่าน / hash) ลงใน detail
model AdminAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorEmail String                          // คนที่กดจริง (raw session — ไม่ใช่เซลล์ที่ถูกดูแทน)
  actorRole  String                          // "creator" | "admin" | "sales"
  action     String                          // เช่น "store.approve" ดูป้ายใน lib/admin/audit-log-labels.ts
  target     String   @default("")           // อีเมล / รหัส / เลขออเดอร์ ที่ถูกกระทำ
  detail     String   @default("")           // JSON สั้น ๆ ของค่าที่เกี่ยวข้อง

  @@index([createdAt])
  @@index([actorEmail])
  @@index([action])
}
